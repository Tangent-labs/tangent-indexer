{
    "extends": "@istanbuljs/nyc-config-typescript",
    "check-coverage": true,
    "all": true,
    "include": ["src/helpers/**", "src/formatter/**", "src/services/**", "src/utils/**", "src/db/**", "src/**.ts"],
    "reporter": ["html", "lcov", "text", "text-summary"],
    "report-dir": "coverage"
}
