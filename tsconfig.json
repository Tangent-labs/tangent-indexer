{
  "compilerOptions": {
    "strict": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "outDir": "dist",
    "sourceMap": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDirs": ["./"],
    "baseUrl": ".",
    "inlineSources": true,
    "sourceRoot": "/",
    "types": ["node"]
  },
  "exclude": ["dist"],
  "include": ["src"]
}
