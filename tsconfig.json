{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "target": "es2020",
    "outDir": "build",
    "sourceMap": true,
    "resolveJsonModule": true,
    "downlevelIteration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDirs": ["./"],
    "baseUrl": "./src",
    "inlineSources": true,
    "sourceRoot": "/",
    "types": ["node"]
  },
  "exclude": ["build"],
  "include": ["src"]
}
