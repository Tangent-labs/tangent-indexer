INDEXING_BLOCK_RANGE=1000
STARTING_BLOCK=23046443
CHAIN_ID=31337
CHAIN_RPCS=http://127.0.0.1:8545/,http://127.0.0.1:8545/
SENTRY_SDN=
DATABASE_URL=postgresql://postgres:@localhost:5432/tangent

# Etherscan V2 multichain key. Only needed by the LP task balance seeder
# (src/scripts/db/add-new/utils/seedInitialBalances.ts), not by the indexers.
ETHERSCAN_API_KEY=
WALLET_PKS=0xdf57089febbacf7ba0bc227dafbffa9fc08a93fdc68e1e42411a14efcf23656e,0xde9be858da4a475276426320d5e9262ecfc3ba460bfac56360bfa6c4c28b4ee0
# HARDHAT #19 , HARDHAT #18
WALLET_ETH_MIN_BALANCE=0.01

TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx
TELEGRAM_MARKET_ACTIVITY_CHAT_ID=xxx


LIQUIDATION_QUEUE_REDIS=redis://127.0.0.1:6379

# Shared data directory for runtime files (market_borrowers.json, transactions.json)
# Default: Windows => %TEMP%\tangent-indexer | Linux => /var/lib/tangent-indexer
# SHARED_DATA_DIR=/var/lib/tangent-indexer

# Snapshot deduplication tolerance (position value change threshold in USD)
# SNAPSHOT_TOLERANCE=0.001

# Monitoring thresholds
# MONITORING_COLLAT_WARNING_MULT=1.2
# MONITORING_COLLAT_DANGER_MULT=1.1
# MONITORING_COLLAT_CRITICAL_MULT=1.03
# MONITORING_LIQDIST_SAFE_PCT=5
# MONITORING_LIQDIST_WARNING_PCT=2
# MONITORING_LIQDIST_DANGER_PCT=1
# MONITORING_LIQDIST_CRITICAL_PCT=0.5
# MONITORING_PEG_SAFE_PCT=0.5
# MONITORING_PEG_WARNING_PCT=2
# MONITORING_PEG_DANGER_PCT=5
# MONITORING_PRICEVAR_STABLE_5M=0.3
# MONITORING_PRICEVAR_STABLE_15M=0.5
# MONITORING_PRICEVAR_STABLE_1H=1
# MONITORING_PRICEVAR_STABLE_4H=2
# MONITORING_PRICEVAR_VOLATILE_5M=2
# MONITORING_PRICEVAR_VOLATILE_15M=5
# MONITORING_PRICEVAR_VOLATILE_1H=10
# MONITORING_PRICEVAR_VOLATILE_4H=15
# MONITORING_ORACLE_DEV_WARNING_PCT=2
# MONITORING_ORACLE_DEV_DANGER_PCT=5
# MONITORING_ORACLE_AGE_WARNING_S=3600
# MONITORING_ORACLE_AGE_DANGER_S=7200
# MONITORING_DEBT_WARNING_PCT=85
# MONITORING_DEBT_DANGER_PCT=95
# MONITORING_TVL_WARNING_1H_PCT=10
# MONITORING_TVL_DANGER_1H_PCT=15
# MONITORING_TVL_WARNING_24H_PCT=20
# MONITORING_TVL_DANGER_24H_PCT=30

# Indexer health monitoring defaults
# MONITORING_INDEXER_HEALTH_WARNING_AFTER_MIN=15
# MONITORING_INDEXER_HEALTH_CRITICAL_AFTER_MIN=60
# MONITORING_INDEXER_HEALTH_CRITICAL_REPEAT_MIN=60
# MONITORING_INDEXER_HEALTH_DEFAULT_MAX_CONSECUTIVE_FAILURES=3

# Indexer health per-indexer overrides
# Supported suffixes: ENABLED, WARNING_AFTER_MIN, CRITICAL_AFTER_MIN, CRITICAL_REPEAT_MIN, MAX_CONSECUTIVE_FAILURES
# Example:
# MONITORING_INDEXER_HEALTH_BLOCK_WARNING_AFTER_MIN=5
# MONITORING_INDEXER_HEALTH_BLOCK_CRITICAL_AFTER_MIN=10
# MONITORING_INDEXER_HEALTH_BLOCK_MAX_CONSECUTIVE_FAILURES=3

# Core/frequent jobs
# MONITORING_INDEXER_HEALTH_BLOCK_ENABLED=true
# MONITORING_INDEXER_HEALTH_BLOCK_WARNING_AFTER_MIN=5
# MONITORING_INDEXER_HEALTH_BLOCK_CRITICAL_AFTER_MIN=10
# MONITORING_INDEXER_HEALTH_BLOCK_CRITICAL_REPEAT_MIN=60
# MONITORING_INDEXER_HEALTH_GLOBAL_DATA_ENABLED=true
# MONITORING_INDEXER_HEALTH_MONITORING_CHECK_ENABLED=true
# MONITORING_INDEXER_HEALTH_SNAPSHOT_PRICES_ENABLED=true
# MONITORING_INDEXER_HEALTH_SNAPSHOT_PRICES_WARNING_AFTER_MIN=15
# MONITORING_INDEXER_HEALTH_SNAPSHOT_PRICES_CRITICAL_AFTER_MIN=60

# Liquidation jobs default to 5m warning / 10m critical / 30m repeat in code
# MONITORING_INDEXER_HEALTH_LIQUIDATION_CHECK_ENABLED=true
# MONITORING_INDEXER_HEALTH_LIQUIDATION_CHECK_WARNING_AFTER_MIN=5
# MONITORING_INDEXER_HEALTH_LIQUIDATION_CHECK_CRITICAL_AFTER_MIN=10
# MONITORING_INDEXER_HEALTH_LIQUIDATION_CHECK_CRITICAL_REPEAT_MIN=30
# MONITORING_INDEXER_HEALTH_LIQUIDATION_PROCESS_ENABLED=true
# MONITORING_INDEXER_HEALTH_LIQUIDATION_PROCESS_WARNING_AFTER_MIN=5
# MONITORING_INDEXER_HEALTH_LIQUIDATION_PROCESS_CRITICAL_AFTER_MIN=10
# MONITORING_INDEXER_HEALTH_LIQUIDATION_PROCESS_CRITICAL_REPEAT_MIN=30

# Hourly-ish jobs default to 120m warning / 180m critical in code
# MONITORING_INDEXER_HEALTH_ONCHAIN_TX_BOT_ENABLED=true
# MONITORING_INDEXER_HEALTH_ONCHAIN_TX_BOT_WARNING_AFTER_MIN=120
# MONITORING_INDEXER_HEALTH_ONCHAIN_TX_BOT_CRITICAL_AFTER_MIN=180
# MONITORING_INDEXER_HEALTH_PEG_KEEPER_UPDATE_ENABLED=true
# MONITORING_INDEXER_HEALTH_PEG_KEEPER_UPDATE_WARNING_AFTER_MIN=120
# MONITORING_INDEXER_HEALTH_PEG_KEEPER_UPDATE_CRITICAL_AFTER_MIN=180

# Daily batch jobs default to 24h warning / 48h critical in code
# MONITORING_INDEXER_HEALTH_POINTS_LP_ENABLED=true
# MONITORING_INDEXER_HEALTH_POINTS_LP_WARNING_AFTER_MIN=1440
# MONITORING_INDEXER_HEALTH_POINTS_LP_CRITICAL_AFTER_MIN=2880
# MONITORING_INDEXER_HEALTH_POINTS_VOTES_ENABLED=true
# MONITORING_INDEXER_HEALTH_POINTS_VOTES_WARNING_AFTER_MIN=1440
# MONITORING_INDEXER_HEALTH_POINTS_VOTES_CRITICAL_AFTER_MIN=2880

# Event-driven jobs are disabled by default in code
# MONITORING_INDEXER_HEALTH_PREDEPOSIT_ENABLED=false
