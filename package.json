{
  "name": "tangent-indexer",
  "version": "1.0.0",
  "type": "module",
  "description": "Will index data in a DB when some event",
  "main": "index.ts",
  "scripts": {
    "tangent:reset-liquidation-test": "npm run db:truncate & npm run tangent:indexer-block & npm run tangent:check-liquidation",
    "tangent:indexer-block": "tsx src/scripts/index_block.ts",
    "tangent:indexer-points-lp": "tsx src/scripts/index_points_lp.ts",
    "tangent:indexer-points-votes": "tsx src/scripts/index_points_votes.ts",
    "tangent:indexer-global-data": "tsx src/scripts/index_global_data.ts",
    "tangent:snapshot-prices": "tsx src/scripts/snapshot_prices.ts",
    "tangent:check-liquidation": "tsx src/scripts/check_liquidation.ts",
    "tangent:onchain_tx_bot": "tsx src/scripts/onchain_tx_bot.ts",
    "tangent:update-price-source-registry": "tsx src/scripts/update_price_source_registry.ts",
    "tangent:send-points-execution-summary": "tsx src/scripts/send_points_execution_summary.ts",
    "tangent:predeposit-script": "tsx src/scripts/predeposit_script.ts",
    "prisma:truncate": "tsx src/scripts/utils/truncate_tables.ts",
    "prisma:generate": "prisma generate --schema node_modules/@tangent/prisma-schema-shared/schema.prisma",
    "prisma:push": "prisma db push --schema node_modules/@tangent/prisma-schema-shared/schema.prisma",
    "prisma:push-force": "prisma db push --schema node_modules/@tangent/prisma-schema-shared/schema.prisma  --accept-data-loss",
    "db:deactivate-tasks": "tsx src/scripts/close_unactive_tasks.ts",
    "db:truncate": "tsx src/scripts/utils/truncate_tables.ts",
    "db:seed-db": "tsx src/scripts/db-seed/_index.ts",
    "db:mock-db-data": "tsx src/scripts/db-mock/_index.ts",
    "db:actualize-views": "tsx src/scripts/actualize-views.ts",
    "build": "node src/utils/build.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ignore-pattern dist/",
    "lint:fix": "eslint .  --fix --ignore-pattern dist/ && prettier --check . --write",
    "lint:tsc": "npx tsc --noEmit",
    "lint:prettier": "prettier --check .",
    "prepare": "husky",
    "format": "prettier --write --list-different . ",
    "validate": "npm run lint && npm run lint:tsc && npm run lint:prettier",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org cvg-mb --project indexer ./build && sentry-cli sourcemaps upload --org cvg-mb --project indexer ./build"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@sentry/cli": "^2.26.0",
    "@sentry/core": "^8.54.0",
    "@sentry/node": "^7.98.0",
    "@sentry/profiling-node": "^1.3.5",
    "axios": "^1.12.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@tangent/defi-resources": "github:Tangent-labs/defi-resources#main",
    "@tangent/prisma-schema-shared": "github:Tangent-labs/prisma-schema-shared#main",
    "@types/node": "^22.18.8",
    "@types/node-fetch": "^2.6.13",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.25.10",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^6.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "prisma": "^6.10.1",
    "source-map-support": "^0.5.21",
    "vitest": "^3.0.5"
  }
}
