{
  "name": "tangent-indexer",
  "version": "1.0.0",
  "type": "module",
  "description": "Will index data in a DB when some event &amp; transactions are detected",
  "main": "index.ts",
  "scripts": {
    "tangent:reset-liquidation-test": "npm run db:truncate &  npm run tangent:indexer-block & npm run tangent:check-liquidation",
    "tangent:feed-tasks": "tsx src/scripts/fill_task_table.ts",
    "tangent:feed-tokens": "tsx src/scripts/seed_tokens.ts",
    "tangent:indexer-points": "tsx src/scripts/index_points.ts",
    "tangent:indexer-block": "tsx src/scripts/index_block.ts",
    "tangent:indexer-tvl-aprs": "tsx src/scripts/index_tvl_aprs.ts",
    "tangent:check-liquidation": "tsx src/scripts/check_liquidation.ts",
    "tangent:check-votes": "tsx src/scripts/check_votes.ts",
    "format": "prettier --write --list-different . ",
    "db:truncate": "tsx src/scripts/utils/truncate_tables.ts",
    "db:push": "npx prisma db push",
    "tangent:test-timestamp": "tsx src/scripts/test_timestamp.ts",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . ",
    "lint:fix": "eslint .  --fix",
    "lint:tsc": "npx tsc --noEmit",
    "lint:prettier": "prettier --check .",
    "prepare": "husky",
    "validate": "npm run lint && npm run lint:tsc && npm run lint:prettier",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org cvg-mb --project indexer ./build && sentry-cli sourcemaps upload --org cvg-mb --project indexer ./build",
    "prisma:generate": "prisma generate --schema node_modules/@tangent/prisma-schema-shared/schema.prisma",
    "prisma:push": "prisma db push --schema node_modules/@tangent/prisma-schema-shared/schema.prisma"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.10.1",
    "@sentry/cli": "^2.26.0",
    "@sentry/core": "^8.54.0",
    "@sentry/node": "^7.98.0",
    "@sentry/profiling-node": "^1.3.5",
    "@types/node": "^18.19.76",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "ethers": "^6.14.0",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@tangent/defi-resources": "github:Tangent-labs/defi-resources#main",
    "@tangent/prisma-schema-shared": "github:Tangent-labs/prisma-schema-shared#working-price-feeds",
    "@eslint/js": "^9.20.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-promise": "^6.6.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.0",
    "prisma": "^6.10.1",
    "source-map-support": "^0.5.21",
    "vitest": "^3.0.5"
  }
}
