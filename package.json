{
    "name": "convergence-indexer",
    "version": "1.0.0",
    "description": "Will index data in a DB when some event &amp; transactions are detected",
    "main": "index.ts",
    "scripts": {
        "test": "mocha -r ts-node/register src/tests/**/*.spec.ts src/tests/**/**/*.spec.ts",
        "coverage": "nyc npm run test",
        "clean": "ts-node src/utils/clean.ts",
        "indexer-block": "ts-node src/index_block.ts",
        "indexer-apr": "ts-node src/index_apr.ts",
        "indexer-debank": "ts-node src/index_debank.ts",
        "indexer-cvgprice": "ts-node src/index_cvg_price.ts",
        "indexer-airdrop": "ts-node src/index_airdrop.ts",
        "compile:prod": "npm run compile && npm run sentry:sourcemaps",
        "compile": "npm run compile-typechain && tsc",
        "compile-typechain": "typechain --target ethers-v6 --out-dir src/typechain 'src/abis/*.json'",
        "sentry:sourcemaps": "sentry-cli sourcemaps inject --org cvg-mb --project indexer ./build && sentry-cli sourcemaps upload --org cvg-mb --project indexer ./build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Convergence-fi/convergence-indexer.git"
    },
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Convergence-fi/convergence-indexer/issues"
    },
    "homepage": "https://github.com/Convergence-fi/convergence-indexer#readme",
    "dependencies": {
        "convergence-defi-tools": "git://github.com/Convergence-fi/convergence-defi-tools.git#main",
        "@prisma/client": "^5.11.0",
        "@sentry/cli": "^2.26.0",
        "@sentry/node": "^7.98.0",
        "@sentry/profiling-node": "^1.3.5",
        "@types/sinon-chai": "^3.2.11",
        "axios": "^1.4.0",
        "dotenv": "^16.0.3",
        "ethers": "^6.11.1",
        "lodash": "^4.17.21",
        "mocha": "^10.2.0",
        "sinon-chai": "^3.7.0"
    },
    "devDependencies": {
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@typechain/ethers-v6": "^0.5.0",
        "@types/chai": "^4.3.9",
        "@types/lodash": "^4.14.195",
        "@types/mocha": "^10.0.3",
        "@types/node": "^18.18.6",
        "@types/sinon": "^10.0.20",
        "chai": "^4.3.10",
        "nyc": "^15.1.0",
        "prisma": "^5.11.0",
        "sinon": "^15.2.0",
        "source-map-support": "^0.5.21",
        "ts-node": "^10.9.1",
        "typechain": "^8.3.1",
        "typescript": "^5.2.2"
    }
}
