generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model global_blocks {
  block_id   BigInt    @id(map: "blocks_pkey") @default(autoincrement())
  created_at DateTime? @db.Timestamptz(6)
}

model market_contracts {
  id                  BigInt                @id(map: "markets_contracts_pkey") @default(autoincrement())
  contract_name       String                @db.VarChar
  collateral_address  String                @db.VarChar
  contract_address    String                @db.VarChar
  contract_type       String                @db.VarChar
  market_global_data  market_global_data[]

  @@index([contract_address], map: "markets_contracts_contract_address_idx")
}

model active_borrowers {
  id               BigInt   @id(map: "markets_borrower_pkey") @default(autoincrement())
  contract_address String  @db.VarChar
  borrower_address String  @db.VarChar
  block_date       DateTime @default(now())
}

model liquidation_bot_log {
  id            BigInt   @id(map: "liquidation_bot_log_pkey") @default(autoincrement())
  execution_key String   @db.Uuid
  is_error      Boolean  @default(false)
  action        String
  data          Json
  date          DateTime @default(now())

  @@index([execution_key], map: "liquidation_bot_log_execution_key_idx")
}

model market_borrow {
  id              BigInt   @id(map: "market_borrow_pkey") @default(autoincrement())
  market          String   @db.VarChar
  account         String   @db.VarChar
  receiver        String   @db.VarChar
  borrowed_amount String   @db.VarChar
  block_date      DateTime
  block_id        Int
  tx_hash         String   @db.VarChar(66)

  @@index([account], map: "market_borrow_account")
  @@index([market], map: "market_borrow_market_address")
}

model market_deposit {
  id            BigInt   @id(map: "market_deposit_pkey") @default(autoincrement())
  market        String   @db.VarChar
  account       String   @db.VarChar
  staked_amount String   @db.VarChar
  block_date    DateTime
  block_id      Int
  tx_hash       String   @db.VarChar(66)

  @@index([account], map: "market_deposit_account")
  @@index([market], map: "market_deposit_market_address")
}

model market_zap_deposit {
  id            BigInt   @id(map: "market_zap_deposit_pkey") @default(autoincrement())
  market        String   @db.VarChar
  account       String   @db.VarChar
  staked_amount String   @db.VarChar
  token_in      String   @db.VarChar
  amount_in     String   @db.VarChar
  block_date    DateTime
  block_id      Int
  tx_hash       String   @db.VarChar(66)

  @@index([account], map: "market_zap_deposit_account")
  @@index([market], map: "market_zap_deposit_market_address")
}

model market_deposit_and_borrow {
  id            BigInt   @id(map: "market_deposit_and_borrow_pkey") @default(autoincrement())
  market        String   @db.VarChar
  account       String   @db.VarChar
  staked_amount String   @db.VarChar
  borrow_amount String   @db.VarChar
  block_date    DateTime
  block_id      Int
  tx_hash       String   @db.VarChar(66)

  @@index([account], map: "market_deposit_and_borrow_account")
  @@index([market], map: "market_deposit_and_borrow_market_address")
}

model market_zap_deposit_and_borrow {
  id            BigInt   @id(map: "market_zap_deposit_and_borrow_pkey") @default(autoincrement())
  market        String   @db.VarChar
  account       String   @db.VarChar
  staked_amount String   @db.VarChar
  borrow_amount String   @db.VarChar
  token_in      String   @db.VarChar
  amount_in     String   @db.VarChar
  block_date    DateTime
  block_id      Int
  tx_hash       String   @db.VarChar(66)

  @@index([account], map: "market_zap_deposit_and_borrow_account")
  @@index([market], map: "market_zap_deposit_and_borrow_market_address")
}

