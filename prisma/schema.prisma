generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model global_blocks {
  block_id   BigInt    @id(map: "blocks_pkey") @default(autoincrement())
  created_at DateTime? @db.Timestamptz(6)
}

model market_contracts {
  id               BigInt  @id(map: "markets_contracts_pkey") @default(autoincrement())
  contract_name    String? @db.VarChar
  contract_address String? @db.VarChar
  contract_type    String? @db.VarChar

  @@index([contract_address], map: "markets_contracts_contract_address_idx")
}

model market_borrower {
  id               BigInt   @id(map: "markets_borrower_pkey") @default(autoincrement())
  contract_address String?  @db.VarChar
  borrower_address String?  @db.VarChar
  check_date       DateTime @default(now())
}

model liquidation_bot_log {
  id            BigInt   @id(map: "liquidation_bot_log_pkey") @default(autoincrement())
  execution_key String   @db.Uuid
  is_error      Boolean  @default(false)
  action        String
  data          Json
  date          DateTime @default(now())

  @@index([execution_key], map: "liquidation_bot_log_execution_key_idx")
}

model market_borrow {
  id             BigInt   @id(map: "market_borrow_pkey") @default(autoincrement())
  account        String   @db.VarChar
  receiver       String   @db.VarChar
  borrowedAmount String   @db.VarChar
  check_date     DateTime
}

model market_deposit {
  id            BigInt   @id(map: "market_deposit_pkey") @default(autoincrement())
  userAddress   String   @db.VarChar
  staked_amount String   @db.VarChar
  depositer     String   @db.VarChar
  check_date    DateTime
}

model market_zap_deposit {
  id            BigInt   @id(map: "market_zap_deposit_pkey") @default(autoincrement())
  userAddress   String   @db.VarChar
  staked_amount String   @db.VarChar
  depositer     String   @db.VarChar
  token_in      String   @db.VarChar
  amount_in     String   @db.VarChar
  check_date    DateTime
}

model market_deposit_and_borrow {
  id            BigInt   @id(map: "market_deposit_and_borrow_pkey") @default(autoincrement())
  userAddress   String   @db.VarChar
  staked_amount String   @db.VarChar
  borrow_amount String   @db.VarChar
  depositer     String   @db.VarChar
  check_date    DateTime
}

model market_zap_deposit_and_borrow {
  id            BigInt   @id(map: "market_zap_deposit_and_borrow_pkey") @default(autoincrement())
  userAddress   String   @db.VarChar
  staked_amount String   @db.VarChar
  borrow_amount String   @db.VarChar
  depositer     String   @db.VarChar
  token_in      String   @db.VarChar
  amount_in     String   @db.VarChar
  check_date    DateTime
}

model market_withdraw {
  id              BigInt   @id(map: "market_withdraw_pkey") @default(autoincrement())
  account         String   @db.VarChar
  withdrawnAmount String   @db.VarChar
  check_date      DateTime
}

model market_repay {
  id           BigInt   @id(map: "market_repay_pkey") @default(autoincrement())
  userAddress  String   @db.VarChar
  repayer      String   @db.VarChar
  repaidAmount String   @db.VarChar
  check_date   DateTime
}

model market_repay_and_withdraw {
  id              BigInt   @id(map: "market_repay_and_withdraw_pkey") @default(autoincrement())
  userAddress     String   @db.VarChar
  withdrawnAmount String   @db.VarChar
  repaidAmount    String   @db.VarChar
  check_date      DateTime
}

model market_zap_repay {
  id           BigInt   @id(map: "market_zap_repay_pkey") @default(autoincrement())
  userAddress  String   @db.VarChar
  repayer      String   @db.VarChar
  repaidAmount String   @db.VarChar
  token_in     String   @db.VarChar
  amount_in    String   @db.VarChar
  check_date   DateTime
}

model market_zap_repay_and_withdraw {
  id              BigInt   @id(map: "market_zap_repay_and_withdraw_pkey") @default(autoincrement())
  userAddress     String   @db.VarChar
  withdrawnAmount String   @db.VarChar
  repaidAmount    String   @db.VarChar
  token_in        String   @db.VarChar
  amount_in       String   @db.VarChar
  check_date      DateTime
}

model market_leverage {
  id             BigInt   @id(map: "market_leverage_pkey") @default(autoincrement())
  account        String   @db.VarChar
  stakedAmount   String   @db.VarChar
  collatBought   String   @db.VarChar
  borrowedAmount String   @db.VarChar
  check_date     DateTime
}

model market_zap_leverage {
  id               BigInt   @id(map: "market_zap_leverage_pkey") @default(autoincrement())
  account          String   @db.VarChar
  stakedAmount     String   @db.VarChar
  collatZapDeposit String   @db.VarChar
  collatLeverage   String   @db.VarChar
  borrowedAmount   String   @db.VarChar
  tokenIn          String   @db.VarChar
  amountIn         String   @db.VarChar
  check_date       DateTime
}
