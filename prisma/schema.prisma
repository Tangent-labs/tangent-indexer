model market_leverage {
  id              BigInt   @id(map: "market_leverage_pkey") @default(autoincrement())
  market          String   @db.VarChar
  account         String   @db.VarChar
  staked_amount   String   @db.VarChar
  collat_bought   String   @db.VarChar
  borrowed_amount String   @db.VarChar
  block_date      DateTime
  block_id        Int
  tx_hash         String   @db.VarChar(66)

  @@index([account], map: "market_leverage_account")
  @@index([market], map: "market_leverage_market_address")
}

model market_zap_leverage {
  id                 BigInt   @id(map: "market_zap_leverage_pkey") @default(autoincrement())
  market             String   @db.VarChar
  account            String   @db.VarChar
  staked_amount      String   @db.VarChar
  collat_zap_deposit String   @db.VarChar
  collat_leverage    String   @db.VarChar
  borrowed_amount    String   @db.VarChar
  token_in           String   @db.VarChar
  amount_in          String   @db.VarChar
  block_date         DateTime
  block_id           Int
  tx_hash            String   @db.VarChar(66)

  @@index([account], map: "market_zap_leverage_account")
  @@index([market], map: "market_zap_leverage_market_address")
