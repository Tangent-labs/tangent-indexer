  market           String   @db.VarChar
  account          String   @db.VarChar
  withdrawn_amount String   @db.VarChar
  repaid_amount    String   @db.VarChar
  is_repay_all     Boolean
  token_in         String   @db.VarChar
  amount_in        String   @db.VarChar
  block_date       DateTime
  block_id         Int
  tx_hash          String   @db.VarChar(66)

  @@index([account], map: "market_zap_repay_and_withdraw_account")
  @@index([market], map: "market_zap_repay_and_withdraw_market_address")
